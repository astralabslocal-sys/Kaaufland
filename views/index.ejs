  <section id="kontakt">
    <span class="eyebrow">Kontakt</span>
    <h2>Sprich mit uns.</h2>
    <p><%- content.kontakt_body %></p>
    <a class="btn-mail" href="mailto:taubenhilfedinslaken@gmail.com">✉ E-Mail schreiben</a>
    <div class="domain">taubenhilfedinslaken.com</div>
    <p>Bürgerinitiative Taubenhilfe Dinslaken</p>
  </section>

  <section id="gaestebuch">
    <span class="eyebrow">Gästebuch</span>
    <h2>Was andere sagen.</h2>
    <p>Hinterlasse uns eine Nachricht – mit Namen oder anonym.</p>

    <form method="POST" action="/gaestebuch" class="guestbook-form">
      <input type="text" name="website" class="hp-field" tabindex="-1" autocomplete="off" aria-hidden="true" />
      <input type="text" name="name" placeholder="Dein Name (optional)" maxlength="80" />
      <textarea name="body" placeholder="Deine Nachricht" maxlength="1000" required rows="3"></textarea>
      <button type="submit" class="btn btn-primary">Nachricht senden</button>
    </form>

    <div class="guestbook-list">
      <% messages.forEach(function(m) { %>
        <div class="guestbook-item">
          <div class="guestbook-meta">
            <strong><%= m.name || 'Anonym' %></strong>
            <span><%= formatDate(m.created_at) %></span>
          </div>
          <p><%= m.body %></p>
        </div>
      <% }) %>
      <% if (!messages.length) { %>
        <p class="guestbook-empty">Noch keine Nachrichten. Sei die/der Erste!</p>
      <% } %>
    </div>
  </section>

</main>

<footer>
  <span>© 2026 Bürgerinitiative Taubenhilfe Dinslaken</span>
  <span>
    <a href="#top">Nach oben ↑</a> ·
    <% if (currentUser) { %>
      <a href="/admin">Admin-Bereich</a>
    <% } else { %>
      <a href="/login">Team-Login</a>
    <% } %>
  </span>
</footer>

<script>
  (function(){
    var burger = document.getElementById('burgerBtn');
    var drawer = document.getElementById('drawer');
    var backdrop = document.getElementById('backdrop');
    var closeBtn = document.getElementById('drawerClose');
    var links = document.querySelectorAll('.dlink');

    function openDrawer(){
      drawer.classList.add('open');
      backdrop.classList.add('open');
      burger.setAttribute('aria-expanded','true');
    }
    function closeDrawer(){
      drawer.classList.remove('open');
      backdrop.classList.remove('open');
      burger.setAttribute('aria-expanded','false');
    }
    burger.addEventListener('click', function(){
      drawer.classList.contains('open') ? closeDrawer() : openDrawer();
    });
    closeBtn.addEventListener('click', closeDrawer);
    backdrop.addEventListener('click', closeDrawer);
    document.addEventListener('keydown', function(e){
      if(e.key === 'Escape') closeDrawer();
    });
    links.forEach(function(a){ a.addEventListener('click', closeDrawer); });

    var bar = document.getElementById('progress');
    function updateProgress(){
      var h = document.documentElement;
      var scrollable = h.scrollHeight - h.clientHeight;
      var pct = scrollable > 0 ? (h.scrollTop / scrollable) * 100 : 0;
      bar.style.width = pct + '%';
    }
    document.addEventListener('scroll', updateProgress, {passive:true});
    updateProgress();
  })();
</script>

</body>
</html>
