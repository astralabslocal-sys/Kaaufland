<!DOCTYPE html>
<html lang="de">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>Passwort ändern – Taubenhilfe Dinslaken</title>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,600&family=Public+Sans:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/css/styles.css">
<link rel="stylesheet" href="/css/admin.css">
</head>
<body>
  <div class="auth-wrap">
    <div class="auth-card">
      <h1>Passwort ändern</h1>
      <p class="sub">Bitte vergib jetzt ein eigenes Passwort (mind. 8 Zeichen).</p>
      <% if (error) { %><div class="auth-error"><%= error %></div><% } %>
      <form method="POST" action="/change-password">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <label for="password">Neues Passwort</label>
        <input type="password" id="password" name="password" required minlength="8" autofocus>
        <label for="password2">Neues Passwort wiederholen</label>
        <input type="password" id="password2" name="password2" required minlength="8">
        <button type="submit" class="btn btn-primary">Passwort speichern</button>
      </form>
    </div>
  </div>
</body>
</html>
