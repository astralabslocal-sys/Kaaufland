# Datenbank (Railway: Postgres-Plugin hinzufügen, DATABASE_URL wird automatisch bereitgestellt)
DATABASE_URL=postgres://user:password@host:5432/dbname
# Nur setzen, falls die Postgres-Verbindung SSL verlangt:
# PGSSL=true

# Zufälliger, langer Zufallsstring zum Signieren der Login-Sessions
SESSION_SECRET=bitte-durch-einen-langen-zufaelligen-string-ersetzen

# Erstes Owner-Konto (wird nur beim allerersten Start angelegt, wenn die
# Nutzer-Tabelle noch leer ist)
OWNER_NAME=Vorname Nachname
OWNER_EMAIL=owner@example.com
OWNER_PASSWORD=bitte-aendern

# Erstes Admin-Konto (ebenfalls nur beim allerersten Start)
ADMIN_NAME=Vorname Nachname
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=bitte-aendern

# Gmail-Konto zum Versenden der Zugangsdaten-E-Mails an neue Mitarbeiter.
# GMAIL_APP_PASSWORD ist ein App-Passwort (nicht das normale Gmail-Passwort!),
# erstellbar unter https://myaccount.google.com/apppasswords
# (setzt 2-Faktor-Authentifizierung für das Konto voraus).
GMAIL_USER=taubenhilfedinslaken@gmail.com
GMAIL_APP_PASSWORD=

NODE_ENV=production
